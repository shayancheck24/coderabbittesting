{
  "name": "pawprice/api",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-pdo_sqlite": "*",
    "symfony/framework-bundle": "^7.4",
    "symfony/console": "^7.4",
    "symfony/runtime": "^7.4",
    "symfony/yaml": "^7.4",
    "doctrine/orm": "^3.5",
    "doctrine/dbal": "^4.3",
    "symfony/cache": "^7.4",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  }
}
